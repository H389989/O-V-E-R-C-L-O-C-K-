-- 🔥 STRONGER KILL ALL OTHERS
killAllBtn.MouseButton1Click:Connect(function()
	local killed = 0
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local char = plr.Character
			local humanoid = char:FindFirstChildOfClass("Humanoid")

			if humanoid then
				-- Primary kill methods
				humanoid.Health = 0
				humanoid:TakeDamage(999999)

				-- Extra aggressive methods
				task.spawn(function()
					for i = 1, 5 do
						if char and humanoid then
							humanoid.Health = 0
							if char:FindFirstChild("Head") then
								char.Head:Destroy()
							end
							if char:FindFirstChild("HumanoidRootPart") then
								char.HumanoidRootPart:Destroy()
							end
							if char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") then
								(char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")):Destroy()
							end
						end
						task.wait(0.1)
					end
				end)

				killed += 1
			end
		end
	end
	print("💀 Kill All executed - Targeted " .. killed .. " player(s)")
	print("   → This is the strongest client-sided version possible")
end)

-- Bring Player TO Me
tpToMeBtn.MouseButton1Click:Connect(function()
	local targetName = usernameBox.Text:match("^%s*(.-)%s*$")
	if targetName == "" then
		print("❌ Please enter a username")
		return
	end

	local targetPlayer = Players:FindFirstChild(targetName)
	if not targetPlayer then
		for _, plr in pairs(Players:GetPlayers()) do
			if plr.Name:lower():find(targetName:lower()) then
				targetPlayer = plr
				break
			end
		end
	end

	if targetPlayer and targetPlayer ~= player and targetPlayer.Character then
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")

		if myRoot and targetRoot then
			targetRoot.CFrame = myRoot.CFrame + Vector3.new(3, 2, 0)
			print("⬇️ Brought " .. targetPlayer.Name .. " to you")
		else
			print("❌ Missing character parts")
		end
	else
		print("❌ Player '" .. targetName .. "' not found")
	end
end)

-- Teleport TO Player
meToThemBtn.MouseButton1Click:Connect(function()
	local targetName = usernameBox.Text:match("^%s*(.-)%s*$")
	if targetName == "" then
		print("❌ Please enter a username")
		return
	end

	local targetPlayer = Players:FindFirstChild(targetName)
	if not targetPlayer then
		for _, plr in pairs(Players:GetPlayers()) do
			if plr.Name:lower():find(targetName:lower()) then
				targetPlayer = plr
				break
			end
		end
	end

	if targetPlayer and targetPlayer.Character then
		local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

		if root and myRoot then
			myRoot.CFrame = root.CFrame + Vector3.new(0, 3, 0)
			print("🚀 Teleported to " .. targetPlayer.Name)
		else
			print("❌ Target has no character")
		end
	else
		print("❌ Player '" .. targetName .. "' not found")
	end
end)

