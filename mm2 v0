local killAllBtn = Instance.new("TextButton")
killAllBtn.Size = UDim2.new(0.9, 0, 0, 50)
killAllBtn.Position = UDim2.new(0.05, 0, 0.65, 0)
killAllBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
